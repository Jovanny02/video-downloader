{
  "name": "headless-video-downloader",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "api": "node dist/src/api.js",
    "worker": "node dist/src/worker.js",
    "migrate": "node dist/src/migrate.js",
    "import": "node dist/src/import.js",
    "test": "npm run build && node --test dist/test/unit.js",
    "test:e2e": "npm run build && node --test dist/test/e2e.js",
    "test:stack": "node test/stack.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-dataexchange": "3.1175.0",
    "dashjs": "5.3.0",
    "fastify": "5.12.8",
    "graphile-worker": "0.18.0",
    "hls.js": "1.7.4",
    "m3u8-parser": "7.2.1",
    "mpd-parser": "1.4.1",
    "pg": "8.23.1",
    "pg-copy-streams": "7.0.0",
    "playwright-core": "1.65.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/pg-copy-streams": "1.2.5",
    "typescript": "5.9.3"
  }
}
